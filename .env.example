# Google Gemini API key, used for summarization and Q&A
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Embeddings run locally via sentence-transformers, so they need no API key.

# Gradio server settings (optional)
GRADIO_SERVER_NAME=127.0.0.1

# Leave unset to let Gradio pick the first free port in 7860-7959.
# Set it only to pin one exact port.
# GRADIO_SERVER_PORT=7860
