# IBM watsonx.ai credentials
# API key: https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=

# Regional endpoint for your watsonx instance, e.g.
#   https://us-south.ml.cloud.ibm.com
#   https://eu-de.ml.cloud.ibm.com
#   https://eu-gb.ml.cloud.ibm.com
#   https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID from your watsonx.ai project's Manage > General page
WATSONX_PROJECT_ID=

# Use this INSTEAD of WATSONX_PROJECT_ID if deploying against a space
# WATSONX_SPACE_ID=

# Gradio server settings (optional)
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
